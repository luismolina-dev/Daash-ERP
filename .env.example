# PostgreSQL
POSTGRES_DB=daash
POSTGRES_USER=daash
POSTGRES_PASSWORD=daash_secret
POSTGRES_PORT=5432

# Backend
SERVER_PORT=8080
JPA_DDL_AUTO=update
SSL_ENABLED=false
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Secretos: reemplázalos por valores aleatorios de al menos 32 caracteres en producción
JWT_SECRET=change-me-access-secret-with-at-least-32-characters-0123456789
REFRESH_SECRET=change-me-refresh-secret-with-at-least-32-characters-0123456789
DTE_SIGNING_SECRET=change-me-dte-signing-secret-with-at-least-32-characters-0123456789

# SMTP para envío real de facturas de compra (dejar MAIL_HOST vacío para modo simulado)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_SSL=false
MAIL_FROM=no-reply@daash.local

# Datos del emisor/receptor que aparecen en el crédito fiscal
COMPANY_NAME=Adventure Works S.A. de C.V.
COMPANY_NIT=0614-123456-100-0
COMPANY_NRC=1234-5
COMPANY_ADDRESS=San Salvador, El Salvador
